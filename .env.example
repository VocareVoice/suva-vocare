# Apertus v1.5 via an OpenAI-compatible endpoint.
# LLM_NAME is the model id as your endpoint names it: apertus-v1-5-70b on the gateway we used,
# e.g. swiss-ai/Apertus-v1.5-70B on Hugging Face-style gateways. Use the regular 70B model, not a
# thinking variant: every result in data/results/ and docs/ was produced with it.
LLM_NAME="apertus-v1-5-70b"
LLM_BASE_URL=https://example.invalid/v1
LLM_API_KEY=changeme

# Optional overrides
# DB_PATH=data/suva.db
# CORPUS_PATH=data/corpus/rulings.jsonl.gz
# LLM_CACHE_DIR=data/cache/llm

# Side-panel agent (native tool calls; calls left in the text are recognised too); defaults to LLM_NAME
# AGENT_MODEL=apertus-v1-5-70b
# AGENT_MAX_STEPS=10
